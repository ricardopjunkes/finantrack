PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# npm run db:local:setup gera credenciais locais aleatórias em backend/.env.
# Ou informe uma conexão PostgreSQL própria:
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:55432/finantrack?schema=public
TEST_DATABASE_URL=postgresql://usuario:senha@127.0.0.1:55432/finantrack_test?schema=public
# Banco descartável usado somente por migrate dev, diferente dos bancos acima.
SHADOW_DATABASE_URL=postgresql://usuario:senha@127.0.0.1:55432/finantrack_shadow?schema=public
# Autenticação e cookies
NODE_ENV=development
COOKIE_CROSS_SITE=false
# 0 local; 1 somente quando a API estiver atrás do proxy confiável do Render.
TRUST_PROXY_HOPS=0
# Opcional no Neon: conexão direta para migrations; DATABASE_URL pode usar pool.
# DIRECT_DATABASE_URL=postgresql://usuario:senha@host-direto/banco?sslmode=require
